{
  "defaultColorScheme": "light",
  "colors": {
    "primary": "#0a246a",
    "secondary": "#316ac5",
    "background": "#3a6ea5",
    "text": "#000000",
    "accent": "#ffffe1"
  },
  "typography": {
    "fontFamily": "Tahoma, Verdana, \"Segoe UI\", sans-serif"
  },
  "spacing": {
    "defaultRadius": "0.375rem"
  },
  "elements": {
    "body": {
      "backgroundColor": "var(--color-background)",
      "color": "var(--color-text)"
    },
    "a": {
      "color": "#0000ee",
      "hover": {
        "color": "#316ac5"
      }
    }
  }
}
